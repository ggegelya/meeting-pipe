<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meetingpipe.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{INSTALL_PREFIX}}/MeetingPipe.app/Contents/MacOS/MeetingPipe</string>
  </array>

  <!-- Auto-start at login. Relaunch only on a non-zero exit: a quit exits 0 and
       stays down (UX82, "Quit means quit"), a requested relaunch exits 75
       (AppDelegate.relaunchExitStatus) and a crash dies by a signal, and both of
       those bring the menu-bar app back. The app breaks its own crash loops
       (CrashLoopBreaker), since launchd has no window to say so in. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Don't fork-bomb if we're crashing on launch; CrashLoopBreaker stops the loop. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/MeetingPipe/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/MeetingPipe/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
