{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/prune-worktrees.sh\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(sh scripts/prune-worktrees.sh)",
      "Bash(./scripts/prune-worktrees.sh)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(uv run --extra dev ruff check:*)",
      "Bash(uv run --extra dev pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find . *)",
      "Bash(find pipeline *)",
      "Bash(find daemon *)",
      "Bash(find scripts *)",
      "Bash(wc *)",
      "Bash(head:*)",
      "Bash(afinfo:*)",
      "Bash(ls:*)",
      "Bash(scripts/tail-events.sh:*)",
      "Bash(./scripts/tail-events.sh:*)",
      "Bash(bash -n scripts/*)"
    ]
  }
}
